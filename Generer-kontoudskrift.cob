       IDENTIFICATION DIVISION.
       PROGRAM-ID. GENKONTOUDSKRIFT.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT TRANSAKTIONSFIL ASSIGN TO "Transaktioner.txt"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT BANKERFIL ASSIGN TO "Banker.txt"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT KONTOUDSKRIFTFIL 
               ASSIGN TO "Output/Kontoudskrifter.txt"
               ORGANIZATION IS LINE SEQUENTIAL.

       DATA DIVISION.
       FILE SECTION.
       FD TRANSAKTIONSFIL.
       01 TRANSAKTION-RECORD.
        COPY "DataStruktur/TRANSAKTIONER.cpy".
       FD BANKERFIL.
       01 BANK-RECORD.
        COPY "DataStruktur/BANKER.cpy".
       
       FD KONTOUDSKRIFTFIL.
       01 KONTOUDSKRIFT-OUT.
           02 OUTPUT-LINJE PIC X(120).
       
       WORKING-STORAGE SECTION.
       01 BANKINFOTAB      PIC X(30)           VALUE SPACES.
       01 USDTILDKK        CONSTANT AS 6.8.
       01 EURTILDKK        CONSTANT AS 7.5.

       01 END-BANKER-READ      PIC X           VALUE "N".
       01 END-OF-TRANSAKTIONER PIC X           VALUE "N".
       01 CURRENT-KONTO        PIC X(12)       VALUE SPACES.

       01 BANKER OCCURS 200 TIMES.
        COPY "DataStruktur/BANKER.cpy".
       01 BANK-INDEX           PIC 9(3)        VALUE 1.

       01 DATO                 PIC X(10)       VALUE SPACES.
       01 KLOKKESLÆT           PIC X(8)        VALUE SPACES.
       01 VALUTABELØB          PIC S9(12)V9(2).
       01 DKKBELØB             PIC S9(12)V9(2).
       01 DKKBELØBVISNING      PIC -ZZ,ZZZ,ZZZ,ZZ9.99.
       01 VALUTABELØBVISNING   PIC -ZZ,ZZZ,ZZZ,ZZ9.99.


       PROCEDURE DIVISION.
       MOVE SPACES TO OUTPUT-LINJE
       PERFORM UDFYLD-BANKER
       OPEN OUTPUT KONTOUDSKRIFTFIL
       OPEN INPUT TRANSAKTIONSFIL
       PERFORM UNTIL END-OF-TRANSAKTIONER = "Y"
           READ TRANSAKTIONSFIL INTO TRANSAKTION-RECORD
               AT END
                   PERFORM UDSKRIV-FOOTER
                   MOVE "Y" TO END-OF-TRANSAKTIONER
               NOT AT END
                   IF KONTO-ID = CURRENT-KONTO
                       PERFORM UDSKRIV-TRANSAKTION
                   ELSE
                       IF CURRENT-KONTO NOT = SPACES
                           PERFORM UDSKRIV-FOOTER
                       END-IF
                       PERFORM OPSÆT-NÆSTE-KUNDE
                       PERFORM UDSKRIV-HEADER
                       PERFORM UDSKRIV-TRANSAKTION
                   END-IF
       END-PERFORM
       CLOSE TRANSAKTIONSFIL
       CLOSE KONTOUDSKRIFTFIL
       
       DISPLAY " "
       DISPLAY "kontoudskrifter genereret og kan findes i " 
                   "Output/Kontoudskrifter.txt"

       STOP RUN.

       UDSKRIV-OUTPUT.
       WRITE KONTOUDSKRIFT-OUT
       MOVE SPACES TO OUTPUT-LINJE.
       
       UDFYLD-BANKER.
       OPEN INPUT BANKERFIL
       MOVE 1 TO BANK-INDEX
       MOVE "N" TO END-BANKER-READ
       PERFORM UNTIL END-BANKER-READ = "Y"
       READ BANKERFIL INTO BANK-RECORD
           AT END
               MOVE "Y" TO END-BANKER-READ
           NOT AT END
               MOVE BANK-RECORD TO BANKER(BANK-INDEX)
               ADD 1 TO BANK-INDEX
       END-PERFORM
       CLOSE BANKERFIL.


       FINDBANK.
       MOVE 1 TO BANK-INDEX
       MOVE "N" TO END-BANKER-READ
       PERFORM UNTIL END-BANKER-READ = "Y" 
               OR BANK-INDEX > LENGTH OF BANKER
           IF BANKER(BANK-INDEX) = SPACES OR
           REG-NR OF TRANSAKTION-RECORD = REG-NR OF BANKER(BANK-INDEX)
               MOVE "Y" TO END-BANKER-READ
           ELSE
               ADD 1 TO BANK-INDEX
           END-IF
       END-PERFORM.


       OPSÆT-NÆSTE-KUNDE.
       DISPLAY "Generer kontoudskrift for " NAVN OF TRANSAKTION-RECORD
       MOVE KONTO-ID TO CURRENT-KONTO
       PERFORM FINDBANK.


       UDSKRIV-HEADER.
       MOVE "----------------------------------------------------------" 
           TO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       STRING "Kunde: " DELIMITED BY SIZE
           NAVN OF TRANSAKTION-RECORD DELIMITED BY SIZE
           INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       STRING "Adresse: " DELIMITED BY SIZE
           ADRESSE OF TRANSAKTION-RECORD DELIMITED BY SIZE
           INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       PERFORM UDSKRIV-OUTPUT
       PERFORM UDSKRIV-BANKINFORMATION
       PERFORM UDSKRIV-OUTPUT
       STRING "Kontoudskrift for kontonr.: " DELIMITED BY SIZE
           KONTO-ID DELIMITED BY SPACE
           INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       PERFORM UDSKRIV-OUTPUT
       STRING "   Dato    | Tidspunkt | Transaktionstype |"
             "     Beløb (DKK)    |   Beløb (Valuta)   |" 
             " Valutakode |    Butik"
             INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT.


       UDSKRIV-BANKINFORMATION.
       STRING BANKINFOTAB DELIMITED BY SIZE
           "Registreringsnummer: " DELIMITED BY SIZE
           REG-NR OF TRANSAKTION-RECORD DELIMITED BY SIZE
           INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       STRING BANKINFOTAB DELIMITED BY SIZE
           "Bank: " DELIMITED BY SIZE
           NAVN OF BANKER(BANK-INDEX) DELIMITED BY SIZE
           INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       STRING BANKINFOTAB DELIMITED BY SIZE
           "Bankadresse: " DELIMITED BY SIZE
           ADRESSE OF BANKER(BANK-INDEX) DELIMITED BY SIZE
           INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       STRING BANKINFOTAB DELIMITED BY SIZE
           "Telefon: " DELIMITED BY SIZE
           TELEFON OF BANKER(BANK-INDEX) DELIMITED BY SIZE
           INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       STRING BANKINFOTAB DELIMITED BY SIZE
           "E-mail: " DELIMITED BY SIZE
           EMAIL OF BANKER(BANK-INDEX) DELIMITED BY SIZE
           INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT.


       UDSKRIV-TRANSAKTION.
       MOVE TIDSPUNKT(1:10) TO DATO
       MOVE TIDSPUNKT(12:8) TO KLOKKESLÆT
       PERFORM KONVERTER-TIL-DKK
       MOVE BELØB TO VALUTABELØBVISNING
       MOVE DKKBELØB TO DKKBELØBVISNING
       STRING DATO DELIMITED BY SPACE
           " |  " DELIMITED BY SIZE
           KLOKKESLÆT DELIMITED BY SPACE
           " | " DELIMITED BY SIZE
           TRANSAKTIONSTYPE DELIMITED BY SIZE
           "  | " DELIMITED BY SIZE
           DKKBELØBVISNING DELIMITED BY SIZE
           " | " DELIMITED BY SIZE
           VALUTABELØBVISNING DELIMITED BY SIZE
           " |     " DELIMITED BY SIZE
           VALUTA DELIMITED BY SIZE
           "    | " DELIMITED BY SIZE
           BUTIK DELIMITED BY SPACE
           INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT.

       KONVERTER-TIL-DKK.
       MOVE BELØB TO VALUTABELØB
       EVALUATE VALUTA
           WHEN 'DKK'
               MOVE BELØB TO DKKBELØB
           WHEN 'USD'
               MULTIPLY VALUTABELØB BY USDTILDKK GIVING DKKBELØB
           WHEN 'EUR'
               MULTIPLY VALUTABELØB BY EURTILDKK GIVING DKKBELØB
       END-EVALUATE.

       UDSKRIV-FOOTER.
       PERFORM UDSKRIV-OUTPUT
       MOVE " -- FOOTER GOES HERE -- " TO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       PERFORM UDSKRIV-OUTPUT
       PERFORM UDSKRIV-OUTPUT.
