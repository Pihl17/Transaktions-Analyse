
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "COBOL: Build and Run",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cobbuild.bat -x \"${file}\" -o \"${fileDirname}\\Build.exe\" && \"${fileDirname}\\Build.exe\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
