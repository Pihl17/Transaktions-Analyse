       IDENTIFICATION DIVISION.
       PROGRAM-ID. GENERER-STATISTIK.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT TRANSAKTIONSFIL ASSIGN TO "Transaktioner.txt"
               ORGANIZATION IS LINE SEQUENTIAL.
           
           SELECT STATISTIKFIL ASSIGN TO "Output/Statistik.txt"
               ORGANIZATION IS LINE SEQUENTIAL.

       DATA DIVISION.
       FILE SECTION.
       FD TRANSAKTIONSFIL.
       01 TRANSAKTION-RECORD.
           COPY "DataStruktur/TRANSAKTIONER.cpy".
       
       FD STATISTIKFIL.
       01 OUTPUT-RECORD.
           02 OUTPUT-LINJE PIC X(90).

       WORKING-STORAGE SECTION.
       78 KUNDER-TOPSALDO-COUNT        VALUE 3.
       78 STARTSALDO                   VALUE 50000.

       01 END-OF-FILE      PIC X       VALUE "N".
       01 IX               PIC 99.
       
       01 SALDOVISNING         PIC ---,---,---,--9.99  OCCURS 2 TIMES.
       01 UHÅNDTERET-TEKST     PIC X(90)   VALUE SPACES.

       01 KUNDER-TOPSALDO OCCURS KUNDER-TOPSALDO-COUNT TIMES.
           02 SALDO            PIC S9(12)V9(2).
           02 NAVN             PIC X(30).
       01 CURRENT-KUNDE.
           02 SALDO            PIC S9(12)V9(2).
           02 NAVN             PIC X(30).
           02 CPR              PIC X(15).
       01 TEMP-KUNDE.        
           02 SALDO            PIC S9(12)V9(2).
           02 NAVN             PIC X(30).
       01 TRANSAKTIONSBELØB    PIC S9(12)V9(2).

       01 MÅNEDER-COUNT        CONSTANT AS 12.
       01 MÅNEDER OCCURS MÅNEDER-COUNT TIMES.
           02 INDBETALING      PIC S9(12)V9(2) VALUE 0.
           02 UDBETALING       PIC S9(12)V9(2) VALUE 0.
       01 MANED-NAVNE VALUE        "Januar   Februar  Marts    April    
      -          "Maj      Juni     Juli     August   SeptemberOktober  
      -    "November December ".
           02 MÅNED-NAVN   PIC X(9) OCCURS MÅNEDER-COUNT TIMES.


       PROCEDURE DIVISION.
       MOVE SPACES TO OUTPUT-LINJE
       OPEN INPUT TRANSAKTIONSFIL
       PERFORM UNTIL END-OF-FILE = "Y"
           READ TRANSAKTIONSFIL INTO TRANSAKTION-RECORD
           AT END
               MOVE "Y" TO END-OF-FILE
               PERFORM OPDATER-TOPSALDO-KUNDER
           NOT AT END
               IF CPR OF TRANSAKTION-RECORD NOT = CPR OF CURRENT-KUNDE
                   IF CPR OF CURRENT-KUNDE NOT = SPACES
                       PERFORM OPDATER-TOPSALDO-KUNDER
                   END-IF
                   PERFORM SET-NY-KUNDE
               END-IF
               PERFORM TILFØJ-TRANSAKTIONSBELØB
       END-PERFORM
       CLOSE TRANSAKTIONSFIL

       OPEN OUTPUT STATISTIKFIL
       PERFORM UDSKRIV-TOPSALDO-KUNDER
       PERFORM UDSKRIV-MÅNEDS-OVERFØRELSER
       CLOSE STATISTIKFIL

       STOP RUN.
       
       UDSKRIV-OUTPUT.
       WRITE OUTPUT-RECORD
       MOVE SPACES TO OUTPUT-LINJE.

       SET-NY-KUNDE.
       MOVE NAVN OF TRANSAKTION-RECORD TO NAVN OF CURRENT-KUNDE
       MOVE CPR OF TRANSAKTION-RECORD TO CPR OF CURRENT-KUNDE
       MOVE STARTSALDO TO SALDO OF CURRENT-KUNDE.

       TILFØJ-TRANSAKTIONSBELØB.
       MOVE BELØB TO TRANSAKTIONSBELØB
       CALL "KONVERTER-TIL-DKK" USING CONTENT TRANSAKTIONSBELØB VALUTA
           REFERENCE TRANSAKTIONSBELØB
       ADD TRANSAKTIONSBELØB TO SALDO OF CURRENT-KUNDE
       IF TRANSAKTIONSBELØB IS POSITIVE
           ADD TRANSAKTIONSBELØB 
               TO INDBETALING OF MÅNEDER(MÅNED OF TRANSAKTION-RECORD)
       ELSE
           ADD TRANSAKTIONSBELØB 
               TO UDBETALING OF MÅNEDER(MÅNED OF TRANSAKTION-RECORD)
       END-IF.

       OPDATER-TOPSALDO-KUNDER.
       PERFORM VARYING IX FROM 1 BY 1 UNTIL IX > KUNDER-TOPSALDO-COUNT
           IF SALDO OF CURRENT-KUNDE > SALDO OF KUNDER-TOPSALDO(IX)
                   OR NAVN OF KUNDER-TOPSALDO(IX) = SPACES
               MOVE KUNDER-TOPSALDO(IX) TO TEMP-KUNDE
               MOVE CURRENT-KUNDE TO KUNDER-TOPSALDO(IX)
               MOVE TEMP-KUNDE TO CURRENT-KUNDE
           END-IF
       END-PERFORM.

       UDSKRIV-TOPSALDO-KUNDER.
       PERFORM UDSKRIV-OUTPUT
       STRING "Top " KUNDER-TOPSALDO-COUNT " kunder med højeste saldo:"
           INTO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       PERFORM VARYING IX FROM 1 BY 1 UNTIL IX > KUNDER-TOPSALDO-COUNT
           MOVE SALDO OF KUNDER-TOPSALDO(IX) TO SALDOVISNING(1)
           STRING IX ". "
                  "Navn: " NAVN OF KUNDER-TOPSALDO(IX) ", "
                  "Saldo: " SALDOVISNING(1) " DKK"
                  INTO UHÅNDTERET-TEKST
           CALL "FJERN-OVERSKYENDE-MELLEMRUM" USING
               REFERENCE OUTPUT-LINJE
               CONTENT UHÅNDTERET-TEKST
           PERFORM UDSKRIV-OUTPUT
       END-PERFORM.
       
       UDSKRIV-MÅNEDS-OVERFØRELSER.
       PERFORM UDSKRIV-OUTPUT
       MOVE "Ind- og udbetalinger for hver måned: " TO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       MOVE "Måned     | Indbetalinger (DKK) | Udbetalinger (DKK)" 
           TO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       MOVE "----------|---------------------|-------------------"
           TO OUTPUT-LINJE
       PERFORM UDSKRIV-OUTPUT
       PERFORM VARYING IX FROM 1 BY 1 UNTIL IX > MÅNEDER-COUNT
           MOVE INDBETALING OF MÅNEDER(IX) TO SALDOVISNING(1)
           MOVE UDBETALING OF MÅNEDER(IX) TO SALDOVISNING(2)
           STRING MÅNED-NAVN(IX)
               " | " SPACE
               SALDOVISNING(1)
               " | "
               SALDOVISNING(2)
               INTO OUTPUT-LINJE
           PERFORM UDSKRIV-OUTPUT
       END-PERFORM.
